# Google Cloud Vision API Credentials
# 1. Создайте проект на https://console.cloud.google.com
# 2. Включите Vision API
# 3. Создайте Service Account и скачайте JSON ключ
# 4. Укажите путь к JSON файлу или содержимое в base64

# Вариант 1: Путь к JSON файлу с ключом
GOOGLE_APPLICATION_CREDENTIALS=./path/to/your/service-account-key.json

# Вариант 2: Или не указывайте - сайт будет работать в ручном режиме

PORT=5000
